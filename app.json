{
  "expo": {
    "name": "paper-pilot",
    "slug": "paper-pilot",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/icon.png",
    "userInterfaceStyle": "light",
    "ios": {
      "supportsTablet": true
    },
    "android": {
      "package": "com.paperpilot.game",
      "adaptiveIcon": {
        "backgroundColor": "#FAF6EE",
        "foregroundImage": "./assets/icon.png"
      },
      "predictiveBackGestureEnabled": false
    },
    "web": {
      "favicon": "./assets/favicon.png"
    },
    "plugins": [
      "expo-font",
      [
        "expo-splash-screen",
        {
          "backgroundColor": "#FAF6EE",
          "image": "./assets/splash.png",
          "imageWidth": 260
        }
      ]
    ],
    "extra": {
      "eas": {
        "projectId": "fac66c8b-6c3f-4674-b097-93815e2df479"
      }
    },
    "owner": "mayankkalra03"
  }
}
